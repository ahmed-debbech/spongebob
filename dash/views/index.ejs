<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>SpongeBob</title>
  <style>
    body{
      font-family:system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial;
      margin:0;
      padding:40px;
      background:#0f0f0f;
      color:#eee;
      display:flex;
      flex-direction:column;
      align-items:center;
    }
    h2{color:#ff8c32;margin-bottom:20px;font-size:28px}

    .container{
      width:100%;
      max-width:700px;
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .row{
      display:flex;
      gap:10px;
      width:100%;
    }
    input[type=text]{
      padding:12px;
      flex:1;
      background:#1a1a1a;
      border:1px solid #333;
      color:#eee;
      border-radius:8px;
    }
    button{
      padding:12px 18px;
      border-radius:8px;
      border:none;
      background:#ff8c32;
      color:#fff;
      font-weight:600;
      cursor:pointer;
      transition:0.2s;
    }
    button:hover{background:#ffa65c}

    .tracks{
      border:1px solid #333;
      border-radius:10px;
      overflow:hidden;
      background:#1a1a1a;
    }
    .tracks-header{
      padding:12px;
      border-bottom:1px solid #333;
      background:#161616;
      font-weight:bold;
    }
    .tracks .list{height:220px;overflow:auto}

    table{width:100%;border-collapse:collapse;color:#eee}
    th,td{padding:10px;border-bottom:1px solid #222;text-align:left}
    tr:hover{background:#181818}

    textarea{
      width:100%;
      height:160px;
      padding:10px;
      background:#1a1a1a;
      border:1px solid #333;
      border-radius:8px;
      color:#eee;
      font-family:monospace;
      resize:vertical;
    }

    .hidden{display:none}
  </style>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

</head>
<body>
  <h2>Set your playlist</h2>
  <div class="container">

    <div class="row">
      <input id="playlistInput" type="text" placeholder="Enter playlist URL" />
      <button id="setBtn">Set</button>
    </div>

    <div class="tracks" id="tracksCard">
      <div class="tracks-header">Tracks</div>
      <div class="list" id="tracksList">
        <table aria-label="playlist tracks">
          <thead>
            <tr><th style="width:72px">#</th><th>Title</th></tr>
          </thead>
          <tbody id="tracksTbody"></tbody>
        </table>
      </div>
    </div>

    <button id="downloadAll" style="width:100%;margin-top:6px">Download all</button>

    <div id="logArea" class="hidden" style="margin-top:10px">
      <textarea id="log" readonly></textarea>
    </div>

    <button onclick="downloadNow()" id="dn" class="hidden" style="width:100%;margin-top:6px; background-color: green;">Download Now!</button>

  </div>

  <script>
    const playlistInput = document.getElementById('playlistInput');
    const setBtn = document.getElementById('setBtn');
    const tracksTbody = document.getElementById('tracksTbody');
    const downloadAll = document.getElementById('downloadAll');
    const logArea = document.getElementById('logArea');
    const logEl = document.getElementById('log');

    let socket = null;

    function downloadNow(){
      document.getElementById("dn").innerText="will begin shortly...";
      setTimeout(()=>{
        document.getElementById("dn").classList.add("hidden")
      }, 4000)
      window.open('/getFile', '_blank')
    }

    function populateTable(list){
      console.log(list)
      tracksTbody.innerHTML = '';
      list.forEach((t,i)=>{
        const tr = document.createElement('tr');
        const tdIdx = document.createElement('td'); tdIdx.textContent = i+1;
        const tdTitle = document.createElement('td'); tdTitle.innerHTML = "<a href='"+t.permalink_url+"'>"+t.title+"</a>";
        tr.appendChild(tdIdx); tr.appendChild(tdTitle);
        tracksTbody.appendChild(tr);
      });
    }

    setBtn.addEventListener('click', ()=>{
      setBtn.innerText = "Setting... please wait"
      setBtn.disabled = true
      $.ajax({
          contentType: 'application/json',
          data: JSON.stringify({
              "playlistUrl" : playlistInput.value
          }),
          dataType: 'json',
          success: function(data){
              setBtn.disabled = false
              console.log(data.tracklist)
              populateTable(data.tracklist);
              setBtn.innerText = "Set"
          },
          error: function(err){
              setBtn.disabled = false
              let g = JSON.parse(err.responseText)
              alert("ERROR: "+ g.reason.because)
              setBtn.innerText = "Set"

          },
          processData: false,
          type: 'POST',
          url: '/setPlaylist'
      });
    });

    function appendLog(line){
      // fixed quoting for newline character
      logEl.value += line + '\n';
      logEl.scrollTop = logEl.scrollHeight;
    }

    downloadAll.addEventListener('click', ()=>{

      $.ajax({
          contentType: 'application/json',
          dataType: 'json',
          success: function(dataa){

            if(dataa.error == true) {alert("ERROR happend even when 200")}

          
          },
          error: function(err){
              setBtn.disabled = false
              let g = JSON.parse(err.responseText)
              alert("ERROR: "+ g.reason.because)
          },
          processData: false,
          type: 'GET',
          url: '/downloadPlaylist'
      });

      const wsUrl = 'ws://'+ location.hostname+':20001/chat';
      logArea.classList.remove('hidden');
      logEl.value = '';
      appendLog('Connecting to ' + wsUrl + ' ...');

      try{
        socket = new WebSocket(wsUrl);
      }catch(err){ appendLog('WebSocket error: ' + err.message); return }

      downloadAll.disabled = true;

      socket.addEventListener('open', ()=>{
        appendLog('Socket opened...');
      });

      socket.addEventListener('message', (ev)=>{
        let data = ev.data;
        try{
          appendLog(data);
          if(data == "[DONE]"){ 
            appendLog('done'); 
            socket.close();  
            document.getElementById("dn").innerText="Download now";
            document.getElementById("dn").classList.remove('hidden')
          }
        }catch(e){
          appendLog(data);
          socket.close();
        }
      });

      socket.addEventListener('close', ()=>{
        appendLog('Socket closed.');
        downloadAll.disabled = false;
      });

      socket.addEventListener('error', ()=>{
        appendLog('Socket error');
        downloadAll.disabled = false;
      });


    });

  </script>
</body>
</html>
